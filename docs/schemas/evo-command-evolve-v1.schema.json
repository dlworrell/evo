{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dlworrell/evo/docs/schemas/evo-command-evolve-v1.schema.json",
  "title": "EVO evolve command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "manifest", "input", "evidence", "output", "providerPolicy", "providers"],
  "properties": {
    "schema": {"const": "catalyst.evo.command.evolve.v1"},
    "operation": {"const": "evolve"},
    "manifest": {"type": "string", "minLength": 1},
    "input": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "output": {"type": "string", "minLength": 1},
    "checkpoint": {"type": "string", "minLength": 1},
    "providerPolicy": {"const": "catalyst.evo.provider-policy.v1"},
    "providers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/provider"}
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "implementationVersion", "capabilities", "available"],
      "properties": {
        "identity": {
          "enum": [
            "catalyst.evo.provider.clang-analysis.v1",
            "catalyst.evo.provider.clang-ast.v1",
            "catalyst.evo.provider.linux-bwrap.v1",
            "catalyst.evo.provider.local-evaluation.v1"
          ]
        },
        "implementationVersion": {"const": 1},
        "capabilities": {"type": "integer", "minimum": 0},
        "available": {"type": "boolean"}
      }
    }
  }
}
