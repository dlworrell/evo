{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dlworrell/evo/examples/reference-adapters-v1.schema.json",
  "title": "EVO Reference Adapter Evidence v1",
  "type": "object",
  "required": ["schema", "schema_version", "adapters"],
  "properties": {
    "schema": {"const": "catalyst.evo-reference-adapters.v1"},
    "schema_version": {"const": "1.0.0"},
    "adapters": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/adapter"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "adapter": {
      "type": "object",
      "required": [
        "schema_version",
        "adapter_id",
        "domain",
        "fixture_id",
        "evo_version",
        "fixture",
        "configuration",
        "capabilities",
        "authority",
        "result",
        "trace",
        "replay"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "adapter_id": {
          "enum": [
            "repository-scoring",
            "compiler-options",
            "scheduler-tuning",
            "fpga-placement"
          ]
        },
        "domain": {"type": "string", "minLength": 1},
        "fixture_id": {"type": "string", "minLength": 1},
        "evo_version": {"const": "0.34.0"},
        "fixture": {"type": "object"},
        "configuration": {"type": "object"},
        "capabilities": {"type": "object"},
        "authority": {"type": "object"},
        "result": {"type": "object"},
        "trace": {"type": "array", "minItems": 1, "maxItems": 7},
        "replay": {"type": "object"},
        "checkpoint_resume": {"type": "object"},
        "evaluation_schedules": {"type": "array", "maxItems": 7}
      },
      "additionalProperties": false
    }
  }
}
